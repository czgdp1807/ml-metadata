# Dockerfile for building ml-metadata from source
FROM --platform=linux/amd64 ubuntu:20.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    curl \
    python3 \
    python3-dev \
    python3-pip \
    pkg-config \
    zip \
    unzip \
    openjdk-11-jdk \
    && rm -rf /var/lib/apt/lists/*

# Install Python build tools and test dependencies
RUN python3 -m pip install --upgrade pip setuptools wheel pytest

# Create python symlink for Bazel (Bazel looks for 'python' not 'python3')
RUN ln -s /usr/bin/python3 /usr/bin/python

# Install Bazel using Bazelisk (works across architectures)
RUN wget https://github.com/bazelbuild/bazelisk/releases/download/v1.19.0/bazelisk-linux-amd64 -O /usr/local/bin/bazel && \
    chmod +x /usr/local/bin/bazel && \
    bazel --version

# Install CMake 3.24
RUN wget https://github.com/Kitware/CMake/releases/download/v3.24.4/cmake-3.24.4-linux-x86_64.tar.gz && \
    tar -xzf cmake-3.24.4-linux-x86_64.tar.gz -C /opt && \
    ln -s /opt/cmake-3.24.4-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    rm cmake-3.24.4-linux-x86_64.tar.gz && \
    cmake --version

# Set working directory
WORKDIR /workspace

# Copy the ml-metadata source
COPY . /workspace/

# Create .bazelversion file to use Bazel 6.5.0 (Bazelisk will use this)
RUN echo "6.5.0" > /workspace/.bazelversion

# Create .bazelrc to limit resource usage
RUN echo 'build --jobs=2' >> /workspace/.bazelrc && \
    echo 'build --local_ram_resources=4096' >> /workspace/.bazelrc && \
    echo 'build --local_cpu_resources=2' >> /workspace/.bazelrc

# Build the wheel
RUN python3 setup.py bdist_wheel

# The wheel will be in /workspace/dist/
CMD ["bash", "-c", "ls -lah /workspace/dist/*.whl && cp /workspace/dist/*.whl /output/ 2>/dev/null || echo 'Build complete. Wheel is in /workspace/dist/'"]
